<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Tickets Dashboard</title>
  <link rel="stylesheet" href="/css/style.css">
</head>

<body>
<div class="layout">

  <aside class="sidebar">
    <div class="logo">
  <div class="logo-icon">🤖</div>
  <div>
    <div class="logo-title">012 Bot</div>
    <div class="logo-status">
      <span class="status-dot"></span>
      Online
    </div>
  </div>
</div>

    <div class="menu">
      <a href="/servers">🏠 Inicio</a>
      <a class="active">🎫 Tickets</a>
      <a>✅ Verificación</a>
      <a>📜 Logs</a>
      <a>⚙️ Configuración</a>
    </div>
  </aside>

  <main class="main">

    <h1>🎫 Ticketing › <%= guild.name %></h1>

    <div class="stats-grid">
      <div class="stat-card">
        <h3>🎫</h3>
        <span>Tickets</span>
        <strong>245</strong>
      </div>

      <div class="stat-card">
        <h3>👥</h3>
        <span>Miembros</span>
        <strong><%= guild.memberCount || 0 %></strong>
      </div>

      <div class="stat-card">
        <h3>⚡</h3>
        <span>Bot</span>
        <strong>Online</strong>
      </div>

      <div class="stat-card">
        <h3>🛡️</h3>
        <span>Servidor</span>
        <strong><%= guild.name %></strong>
      </div>
    </div>

    <form id="ticketForm" method="POST" action="/dashboard/<%= guild.id %>/tickets">

      <div class="dashboard-grid">

        <section>

          <div class="card">
            <h2>🎫 Panel de Tickets</h2>

            <label>Nombre del panel</label>
            <input class="input" name="ticketPanelName" id="panelName"
              placeholder="Ej: Sistema de Tickets — 012 Shop"
              value="<%= config.ticketPanelName || '' %>">

            <label>Canal del panel</label>
            <select class="input" name="ticketPanelChannelId">
              <option value="">Seleccionar canal</option>
              <% textChannels.forEach(channel => { %>
                <option value="<%= channel.id %>" <%= config.ticketPanelChannelId === channel.id ? "selected" : "" %>>
                  #<%= channel.name %>
                </option>
              <% }) %>
            </select>

            <label>Rol de soporte</label>
            <select class="input" name="supportRoleId">
              <option value="">Seleccionar rol</option>
              <% roles.forEach(role => { %>
                <option value="<%= role.id %>" <%= config.supportRoleId === role.id ? "selected" : "" %>>
                  <%= role.name %>
                </option>
              <% }) %>
            </select>

            <label>Color del embed</label>
            <div class="color-row">
              <% ["#23a559","#3498db","#9b59b6","#e91e63","#f1c40f","#e67e22","#e74c3c","#95a5a6","#ffffff"].forEach(color => { %>
                <label class="color-dot" style="background:<%= color %>">
                  <input type="radio" name="ticketEmbedColor" value="<%= color %>"
                    <%= (config.ticketEmbedColor || "#23a559") === color ? "checked" : "" %>>
                </label>
              <% }) %>
            </div>

            <label>Mensaje del panel</label>
            <textarea class="textarea big" name="ticketPanelMessage" id="panelMessage"
placeholder="Escribí el mensaje que aparecerá en el panel de tickets..."><%= config.ticketPanelMessage || '' %></textarea>
          </div>

          <div class="card">
            <h2>⚙️ Configuración del Ticket</h2>

            <label>Categoría abierta</label>
            <select class="input" name="ticketCategoryId">
              <option value="">Seleccionar categoría</option>
              <% categories.forEach(category => { %>
                <option value="<%= category.id %>" <%= config.ticketCategoryId === category.id ? "selected" : "" %>>
                  <%= category.name %>
                </option>
              <% }) %>
            </select>

            <label>Patrón de nombres</label>
            <input class="input" name="ticketNamePattern"
              value="<%= config.ticketNamePattern || 'ticket-{user.username}' %>">

            <label>Límite de tickets por usuario</label>
            <input class="input" type="number" min="1" name="ticketLimit"
              value="<%= config.ticketLimit || 1 %>">
          </div>

          <div class="card">
            <h2>👋 Mensaje de Bienvenida</h2>

            <label>Mensaje cuando se abre un ticket</label>
            <textarea class="textarea big" name="ticketWelcomeMessage" id="welcomeMessage"
placeholder="Mensaje que verá el usuario dentro del ticket..."><%= config.ticketWelcomeMessage || '' %></textarea>

            <small>Variables: {user}, {user.id}, {user.username}, {server.name}, {channel.name}</small>
          </div>

          <div class="card">
            <h2>📜 Registros</h2>

            <label>Canal de registros</label>
            <select class="input" name="ticketLogsChannelId">
              <option value="">Seleccionar canal</option>
              <% textChannels.forEach(channel => { %>
                <option value="<%= channel.id %>" <%= config.ticketLogsChannelId === channel.id ? "selected" : "" %>>
                  #<%= channel.name %>
                </option>
              <% }) %>
            </select>
          </div>

          <div class="actions">
            <button class="btn green" type="submit" formaction="/dashboard/<%= guild.id %>/tickets">
              💾 Guardar cambios
            </button>

            <button class="btn" type="submit" formaction="/dashboard/<%= guild.id %>/tickets/send-panel">
              📤 Enviar panel al canal
            </button>
          </div>

        </section>

        <aside class="preview-box">
          <h2>👀 Vista previa</h2>

          <div class="discord-preview">
            <div class="preview-author">
              🤖 012 Bot <span>APP</span>
            </div>

            <div class="preview-embed" id="previewEmbed">
              <h3 id="previewTitle"><%= config.ticketPanelName || 'Sistema de Tickets — 012 Shop' %></h3>
              <p id="previewText"><%= config.ticketPanelMessage || 'Selecciona una opción para abrir un ticket.' %></p>
            </div>

            <div class="discord-buttons">
              <button type="button" class="discord-btn">🎫 Abrir Ticket</button>
            </div>
          </div>

          <div class="discord-preview ticket-message-preview">
            <div class="preview-author">
              🎫 Ticket creado
            </div>

            <div class="preview-embed">
              <h3>Bienvenido a tu ticket</h3>
              <p id="welcomePreview"><%= config.ticketWelcomeMessage || 'Hola {user}, un miembro del staff te atenderá pronto.' %></p>
            </div>
          </div>
        </aside>

      </div>

    </form>

  </main>
</div>

<script>
const panelName = document.getElementById("panelName");
const panelMessage = document.getElementById("panelMessage");
const welcomeMessage = document.getElementById("welcomeMessage");

const previewTitle = document.getElementById("previewTitle");
const previewText = document.getElementById("previewText");
const welcomePreview = document.getElementById("welcomePreview");
const previewEmbed = document.getElementById("previewEmbed");

function updatePreview() {
  previewTitle.innerText = panelName.value || "Sistema de Tickets — 012 Shop";
  previewText.innerText = panelMessage.value || "Selecciona una opción para abrir un ticket.";

  if (welcomeMessage) {
    welcomePreview.innerText = welcomeMessage.value || "Hola {user}, un miembro del staff te atenderá pronto.";
  }

  const selectedColor = document.querySelector("input[name='ticketEmbedColor']:checked");

  if (selectedColor) {
    previewEmbed.style.borderLeftColor = selectedColor.value;
  }
}

panelName.addEventListener("input", updatePreview);
panelMessage.addEventListener("input", updatePreview);
welcomeMessage.addEventListener("input", updatePreview);

document.querySelectorAll("input[name='ticketEmbedColor']").forEach(input => {
  input.addEventListener("change", updatePreview);
});

updatePreview();
</script>

</body>
</html>