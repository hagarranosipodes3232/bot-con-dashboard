<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Servidores</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="black-page">

<div class="servers-page">

  <div class="topbar">
    <h1>🤖 012 Bot</h1>
    <a class="btn green" href="/invite">➕ Añadir a Discord</a>
  </div>

  <h2>Seleccioná un servidor</h2>

  <div class="server-grid">
    <% guilds.forEach(guild => { %>
      <div class="server-card">
        <h3><%= guild.name %></h3>

        <% if (botGuilds.includes(guild.id)) { %>
          <a class="btn" href="/dashboard/<%= guild.id %>">
            ⚙️ Gestionar servidor
          </a>
        <% } else { %>
          <a class="btn green" href="/invite">
            ➕ Añadir bot
          </a>
        <% } %>
      </div>
    <% }) %>
  </div>

</div>

</body>
</html>