<!DOCTYPE html>

<html lang="es">
<head>
<meta charset="UTF-8">
<title>Estadísticas</title>
<link rel="stylesheet" href="/css/style.css">
</head>
<body>

<div class="layout">

<aside class="sidebar">
  <div class="logo">
    <div class="logo-icon">🤖</div>
    <div>
      <div class="logo-title">012 Bot</div>
      <div class="logo-status">
        <span class="status-dot"></span> Online
      </div>
    </div>
  </div>

  <div class="menu">
    <a href="/servers">🏠 Dashboard</a>
    <a href="/dashboard/<%= guild.id %>/tickets">🎫 Tickets</a>
    <a href="/dashboard/<%= guild.id %>/verification">🛡️ Verificación</a>
    <a class="active" href="/dashboard/<%= guild.id %>/stats">📊 Estadísticas</a>
    <a href="/dashboard/<%= guild.id %>/logs">📜 Logs</a>
    <a href="/dashboard/<%= guild.id %>/configuration">⚙️ Configuración</a>
  </div>

  <div class="sidebar-footer">
    <span>Servidor actual</span>
    <strong><%= guild.name %></strong>
  </div>
</aside>

<main class="main">

<div class="page-header">
  <div class="page-title">
    <span class="eyebrow">Dashboard Premium</span>
    <h1>📊 Estadísticas</h1>
    <p>Información general del servidor y del bot.</p>
  </div>
</div>

<div class="stats-grid">

  <div class="stat-card">
    <div class="stat-icon">👥</div>
    <span>Miembros</span>
    <strong><%= stats.members %></strong>
  </div>

  <div class="stat-card">
    <div class="stat-icon">🤖</div>
    <span>Bot</span>
    <strong>Online</strong>
  </div>

  <div class="stat-card">
    <div class="stat-icon">🎫</div>
    <span>Tickets</span>
    <strong><%= config.ticketsEnabled ? "Activo" : "Desactivado" %></strong>
  </div>

  <div class="stat-card">
    <div class="stat-icon">🛡️</div>
    <span>Verificación</span>
    <strong><%= config.verificationEnabled ? "Activa" : "Desactivada" %></strong>
  </div>

</div>

<div class="card">
  <h2>📈 Resumen</h2>

  <div class="preview-fields">

```
<div>
  <strong>Servidor</strong><br>
  <%= guild.name %>
</div>

<div>
  <strong>ID</strong><br>
  <%= guild.id %>
</div>

<div>
  <strong>Miembros</strong><br>
  <%= stats.members %>
</div>
```

  </div>
</div>

</main>
</div>

</body>
</html>
